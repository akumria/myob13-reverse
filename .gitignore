__pycache__/
*.pyc
data/

# Reverse-engineering workspace, local-only: the MYOB v13 installer archive,
# Ghidra + JDK archives, and REA/Ghidra analysis output. Install archives are
# kept but their extracted trees are not -- run scripts/extract.sh to unpack.
# tools/README.md is the one exception: it is tracked so there is always a
# human-readable description of what belongs in here.
tools/*
!tools/README.md
